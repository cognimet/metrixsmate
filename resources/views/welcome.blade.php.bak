    <!-- Features -->
    <section id="features" class="py-20 bg-white">
        <div class="max-w-6xl mx-auto px-6 text-center">
            <h3 class="text-3xl font-bold text-brandBlue">Why Choose Our Platform?</h3>
            <p class="mt-4 text-gray-600">We combine science, technology, and design to give you assessments that are accurate, engaging, and insightful.</p>
            <div class="grid md:grid-cols-3 gap-10 mt-12">
                <div class="p-6 rounded-xl bg-brandGray shadow hover:shadow-lg">
                    <h4 class="text-xl font-semibold text-brandBlue mb-3">OCEAN Personality Test</h4>
                    <p class="text-gray-600">Understand yourself through the Big Five traits: openness, conscientiousness, extraversion, agreeableness, and neuroticism.</p>
                </div>
                <div class="p-6 rounded-xl bg-brandGray shadow hover:shadow-lg">
                    <h4 class="text-xl font-semibold text-brandBlue mb-3">RIASEC Career Assessment</h4>
