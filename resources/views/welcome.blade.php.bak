    <!-- FAQ -->
    <section id="faq" class="py-20 bg-brandGray">
        <div class="max-w-4xl mx-auto px-6">
            <h3 class="text-3xl font-bold text-center text-brandBlue">Frequently Asked Questions</h3>
            <div class="mt-10 space-y-6">
                <div>
                    <h4 class="font-semibold text-lg text-brandBlue">Are the assessments scientifically valid?</h4>
                    <p class="text-gray-600">Yes, all our assessments are based on widely recognized and validated psychological models.</p>
                </div>
                <div>
                    <h4 class="font-semibold text-lg text-brandBlue">How long does it take?</h4>
                    <p class="text-gray-600">Each test takes between 10–20 minutes depending on your pace.</p>
                </div>
                <div>
                    <h4 class="font-semibold text-lg text-brandBlue">Will I get a detailed report?</h4>
