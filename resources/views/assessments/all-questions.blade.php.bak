<!-- Frontend Validation -->
<script>
    document.getElementById("quizForm").addEventListener("submit", function(e) {
        let valid = true;
        let firstErrorBlock = null;
    
        document.querySelectorAll(".question-block").forEach(block => {
            const radios = block.querySelectorAll("input[type='radio']");
            const checked = Array.from(radios).some(r => r.checked);
            const error = block.querySelector(".error-message");
    
            if (!checked) {
                error.classList.remove("hidden");
                if (!firstErrorBlock) {
                    firstErrorBlock = block;
                }
                valid = false;
            } else {
                error.classList.add("hidden");
            }
        });
    
        if (!valid) {
            e.preventDefault();
    
            // Scroll smoothly to the first error question
            firstErrorBlock.scrollIntoView({
                behavior: 'smooth',
                block: 'center'
            });
        }
    });
    
    // Auto-hide error when user selects an answer
    document.querySelectorAll("input[type='radio']").forEach(radio => {
        radio.addEventListener("change", function() {
            const block = this.closest(".question-block");
            block.querySelector(".error-message").classList.add("hidden");
        });
    });
</script>
    
@endsection
